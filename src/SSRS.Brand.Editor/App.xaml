<Application x:Class="SSRS.Brand.Editor.App"
						 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:vm="clr-namespace:SSRS.Brand.Editor.Application.ViewModels;assembly=SSRS.Brand.Editor.Application"
						 xmlns:v="clr-namespace:SSRS.Brand.Editor.Presentation.Controls;assembly=SSRS.Brand.Editor.Presentation"
						 Startup="Application_Startup"
						 Exit="Application_Exit">
	<Application.Resources>
		<DropShadowEffect x:Key="CardShadow"
											BlurRadius="20"
											ShadowDepth="2"
											Opacity="0.15"
											Color="Black" />
		<DataTemplate DataType="{x:Type TypeName=vm:AboutViewModel}">
			<v:AboutControl />
		</DataTemplate>
		<DataTemplate DataType="{x:Type TypeName=vm:BrandEditorViewModel}">
			<v:BrandEditorControl />
		</DataTemplate>
	</Application.Resources>
</Application>
