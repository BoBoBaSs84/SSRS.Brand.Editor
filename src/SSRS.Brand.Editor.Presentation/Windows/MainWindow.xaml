<Window x:Class="SSRS.Brand.Editor.Presentation.Windows.MainWindow"
				xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
				xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
				xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
				xmlns:vm="clr-namespace:SSRS.Brand.Editor.Application.ViewModels;assembly=SSRS.Brand.Editor.Application"
				d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
				mc:Ignorable="d"
				Title="SSRS.Brand.Editor"
				Height="720"
				Width="1280">
	<DockPanel LastChildFill="True">
		<Menu DockPanel.Dock="Top">
			<MenuItem Header="_File">
				<MenuItem Header="_New" />
				<MenuItem Header="_Open" />
				<MenuItem Header="_Save" />
				<Separator />
				<MenuItem Header="_Quit" />
			</MenuItem>
		</Menu>
		<Grid>
			<TextBox x:Name="textBox"
							 HorizontalAlignment="Left"
							 Margin="183,135,0,0"
							 TextWrapping="Wrap"
							 Text="{Binding Text}"
							 VerticalAlignment="Top"
							 Width="120" />
			<Button x:Name="getTextButton"
							Content="Get Text"
							Command="{Binding Path=GetTextCommand}"
							HorizontalAlignment="Left"
							Margin="308,135,0,0"
							VerticalAlignment="Top" />
			<Button x:Name="setTextButton"
							Content="Set Text"
							Command="{Binding Path=SetTextCommand}"
							HorizontalAlignment="Left"
							Margin="360,135,0,0"
							VerticalAlignment="Top" />
		</Grid>
	</DockPanel>
</Window>
