<UserControl x:Class="SSRS.Brand.Editor.Presentation.Controls.InterfaceColorsEditorControl"
						 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:vm="clr-namespace:SSRS.Brand.Editor.Application.ViewModels;assembly=SSRS.Brand.Editor.Application"
						 xmlns:local="clr-namespace:SSRS.Brand.Editor.Presentation.Controls"
						 mc:Ignorable="d"
						 d:DataContext="{d:DesignInstance Type=vm:InterfaceColorsViewModel}"
						 d:Background="WhiteSmoke"
						 d:Width="380">
	<ScrollViewer VerticalScrollBarVisibility="Auto"
								Padding="8">
		<StackPanel Margin="8">
			<TextBlock Text="Interface Colors"
								 FontSize="16"
								 FontWeight="SemiBold"
								 Margin="0,0,0,12" />

			<!-- Primary -->
			<Expander Header="Primary"
								IsExpanded="True"
								Margin="0,0,0,4">
				<StackPanel Margin="4">
					<local:ColorSwatchControl Label="Primary"
																		Color="{Binding Model.Primary}" />
					<local:ColorSwatchControl Label="PrimaryAlt"
																		Color="{Binding Model.PrimaryAlt}" />
					<local:ColorSwatchControl Label="PrimaryAlt2"
																		Color="{Binding Model.PrimaryAlt2}" />
					<local:ColorSwatchControl Label="PrimaryAlt3"
																		Color="{Binding Model.PrimaryAlt3}" />
					<local:ColorSwatchControl Label="PrimaryAlt4"
																		Color="{Binding Model.PrimaryAlt4}" />
					<local:ColorSwatchControl Label="PrimaryContrast"
																		Color="{Binding Model.PrimaryContrast}" />
				</StackPanel>
			</Expander>

			<!-- Secondary -->
			<Expander Header="Secondary"
								Margin="0,0,0,4">
				<StackPanel Margin="4">
					<local:ColorSwatchControl Label="Secondary"
																		Color="{Binding Model.Secondary}" />
					<local:ColorSwatchControl Label="SecondaryAlt"
																		Color="{Binding Model.SecondaryAlt}" />
					<local:ColorSwatchControl Label="SecondaryAlt2"
																		Color="{Binding Model.SecondaryAlt2}" />
					<local:ColorSwatchControl Label="SecondaryAlt3"
																		Color="{Binding Model.SecondaryAlt3}" />
					<local:ColorSwatchControl Label="SecondaryContrast"
																		Color="{Binding Model.SecondaryContrast}" />
				</StackPanel>
			</Expander>

			<!-- Neutral Primary -->
			<Expander Header="Neutral Primary"
								Margin="0,0,0,4">
				<StackPanel Margin="4">
					<local:ColorSwatchControl Label="NeutralPrimary"
																		Color="{Binding Model.NeutralPrimary}" />
					<local:ColorSwatchControl Label="NeutralPrimaryAlt"
																		Color="{Binding Model.NeutralPrimaryAlt}" />
					<local:ColorSwatchControl Label="NeutralPrimaryAlt2"
																		Color="{Binding Model.NeutralPrimaryAlt2}" />
					<local:ColorSwatchControl Label="NeutralPrimaryAlt3"
																		Color="{Binding Model.NeutralPrimaryAlt3}" />
					<local:ColorSwatchControl Label="NeutralPrimaryContrast"
																		Color="{Binding Model.NeutralPrimaryContrast}" />
				</StackPanel>
			</Expander>

			<!-- Neutral Secondary -->
			<Expander Header="Neutral Secondary"
								Margin="0,0,0,4">
				<StackPanel Margin="4">
					<local:ColorSwatchControl Label="NeutralSecondary"
																		Color="{Binding Model.NeutralSecondary}" />
					<local:ColorSwatchControl Label="NeutralSecondaryAlt"
																		Color="{Binding Model.NeutralSecondaryAlt}" />
					<local:ColorSwatchControl Label="NeutralSecondaryAlt2"
																		Color="{Binding Model.NeutralSecondaryAlt2}" />
					<local:ColorSwatchControl Label="NeutralSecondaryAlt3"
																		Color="{Binding Model.NeutralSecondaryAlt3}" />
					<local:ColorSwatchControl Label="NeutralSecondaryContrast"
																		Color="{Binding Model.NeutralSecondaryContrast}" />
				</StackPanel>
			</Expander>

			<!-- Neutral Tertiary -->
			<Expander Header="Neutral Tertiary"
								Margin="0,0,0,4">
				<StackPanel Margin="4">
					<local:ColorSwatchControl Label="NeutralTertiary"
																		Color="{Binding Model.NeutralTertiary}" />
					<local:ColorSwatchControl Label="NeutralTertiaryAlt"
																		Color="{Binding Model.NeutralTertiaryAlt}" />
					<local:ColorSwatchControl Label="NeutralTertiaryAlt2"
																		Color="{Binding Model.NeutralTertiaryAlt2}" />
					<local:ColorSwatchControl Label="NeutralTertiaryAlt3"
																		Color="{Binding Model.NeutralTertiaryAlt3}" />
					<local:ColorSwatchControl Label="NeutralTertiaryContrast"
																		Color="{Binding Model.NeutralTertiaryContrast}" />
				</StackPanel>
			</Expander>

			<!-- Status -->
			<Expander Header="Status"
								Margin="0,0,0,4">
				<StackPanel Margin="4">
					<local:ColorSwatchControl Label="Danger"
																		Color="{Binding Model.Danger}" />
					<local:ColorSwatchControl Label="DangerContrast"
																		Color="{Binding Model.DangerContrast}" />
					<local:ColorSwatchControl Label="Success"
																		Color="{Binding Model.Success}" />
					<local:ColorSwatchControl Label="SuccessContrast"
																		Color="{Binding Model.SuccessContrast}" />
					<local:ColorSwatchControl Label="Warning"
																		Color="{Binding Model.Warning}" />
					<local:ColorSwatchControl Label="WarningContrast"
																		Color="{Binding Model.WarningContrast}" />
					<local:ColorSwatchControl Label="Info"
																		Color="{Binding Model.Info}" />
					<local:ColorSwatchControl Label="InfoContrast"
																		Color="{Binding Model.InfoContrast}" />
				</StackPanel>
			</Expander>

			<!-- KPI -->
			<Expander Header="KPI"
								Margin="0,0,0,4">
				<StackPanel Margin="4">
					<local:ColorSwatchControl Label="KpiGood"
																		Color="{Binding Model.KpiGood}" />
					<local:ColorSwatchControl Label="KpiGoodContrast"
																		Color="{Binding Model.KpiGoodContrast}" />
					<local:ColorSwatchControl Label="KpiBad"
																		Color="{Binding Model.KpiBad}" />
					<local:ColorSwatchControl Label="KpiBadContrast"
																		Color="{Binding Model.KpiBadContrast}" />
					<local:ColorSwatchControl Label="KpiNeutral"
																		Color="{Binding Model.KpiNeutral}" />
					<local:ColorSwatchControl Label="KpiNeutralContrast"
																		Color="{Binding Model.KpiNeutralContrast}" />
					<local:ColorSwatchControl Label="KpiNone"
																		Color="{Binding Model.KpiNone}" />
					<local:ColorSwatchControl Label="KpiNoneContrast"
																		Color="{Binding Model.KpiNoneContrast}" />
				</StackPanel>
			</Expander>

			<!-- Icons -->
			<Expander Header="Icons"
								Margin="0,0,0,4">
				<StackPanel Margin="4">
					<local:ColorSwatchControl Label="ItemTypeIconColor"
																		Color="{Binding Model.ItemTypeIconColor}" />
					<local:ColorSwatchControl Label="ReportIconBackground"
																		Color="{Binding Model.ReportIconBackground}" />
					<local:ColorSwatchControl Label="ExcelIconBackground"
																		Color="{Binding Model.ExcelIconBackground}" />
					<local:ColorSwatchControl Label="FolderIconBackground"
																		Color="{Binding Model.FolderIconBackground}" />
					<local:ColorSwatchControl Label="DatasetIconBackground"
																		Color="{Binding Model.DatasetIconBackground}" />
					<local:ColorSwatchControl Label="OtherIconBackground"
																		Color="{Binding Model.OtherIconBackground}" />
				</StackPanel>
			</Expander>

			<!-- Buttons -->
			<Expander Header="Buttons"
								Margin="0,0,0,4">
				<StackPanel Margin="4">
					<local:ColorSwatchControl Label="PrimaryButton"
																		Color="{Binding Model.PrimaryButton}" />
					<local:ColorSwatchControl Label="PrimaryButtonHover"
																		Color="{Binding Model.PrimaryButtonHover}" />
					<local:ColorSwatchControl Label="PrimaryButtonPressed"
																		Color="{Binding Model.PrimaryButtonPressed}" />
				</StackPanel>
			</Expander>

			<!-- Links -->
			<Expander Header="Links"
								Margin="0,0,0,4">
				<StackPanel Margin="4">
					<local:ColorSwatchControl Label="Link"
																		Color="{Binding Model.Link}" />
					<local:ColorSwatchControl Label="LinkHover"
																		Color="{Binding Model.LinkHover}" />
					<local:ColorSwatchControl Label="LinkVisited"
																		Color="{Binding Model.LinkVisited}" />
				</StackPanel>
			</Expander>

			<!-- Controls -->
			<Expander Header="Controls"
								Margin="0,0,0,4">
				<StackPanel Margin="4">
					<local:ColorSwatchControl Label="RadioButtonCheckBox"
																		Color="{Binding Model.RadioButtonCheckBox}" />
					<local:ColorSwatchControl Label="RadioButtonCheckBoxHover"
																		Color="{Binding Model.RadioButtonCheckBoxHover}" />
				</StackPanel>
			</Expander>
		</StackPanel>
	</ScrollViewer>
</UserControl>
