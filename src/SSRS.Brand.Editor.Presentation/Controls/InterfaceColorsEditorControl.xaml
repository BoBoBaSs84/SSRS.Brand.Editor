<UserControl x:Class="SSRS.Brand.Editor.Presentation.Controls.InterfaceColorsEditorControl"
						 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:vm="clr-namespace:SSRS.Brand.Editor.Application.ViewModels;assembly=SSRS.Brand.Editor.Application"
						 xmlns:conv="clr-namespace:SSRS.Brand.Editor.Presentation.Converters"
						 mc:Ignorable="d"
						 d:DataContext="{d:DesignInstance Type=vm:InterfaceColorsViewModel}"
						 d:Background="WhiteSmoke"
						 d:Width="380">
	<UserControl.Resources>
		<conv:DrawingColorToBrushConverter x:Key="ColorToBrush" />
		<Style x:Key="SwatchRect"
					 TargetType="Rectangle">
			<Setter Property="Width"
							Value="24" />
			<Setter Property="Height"
							Value="24" />
			<Setter Property="Stroke"
							Value="Gray" />
			<Setter Property="StrokeThickness"
							Value="1" />
			<Setter Property="RadiusX"
							Value="2" />
			<Setter Property="RadiusY"
							Value="2" />
			<Setter Property="Margin"
							Value="0,0,8,0" />
		</Style>
	</UserControl.Resources>
	<ScrollViewer VerticalScrollBarVisibility="Auto"
								Padding="8">
		<StackPanel Margin="8">
			<TextBlock Text="Interface Colors"
								 FontSize="16"
								 FontWeight="SemiBold"
								 Margin="0,0,0,12" />

			<!-- Primary -->
			<Expander Header="Primary"
								IsExpanded="True"
								Margin="0,0,0,4">
				<StackPanel Margin="4">
					<DockPanel Margin="2">
						<Rectangle Style="{StaticResource SwatchRect}"
											 Fill="{Binding Model.Primary, Converter={StaticResource ColorToBrush}}" />
						<TextBlock Text="Primary"
											 Width="140"
											 VerticalAlignment="Center" />
						<TextBlock Text="{Binding Model.Primary, Converter={StaticResource ColorToBrush}, StringFormat={}{0}}"
											 VerticalAlignment="Center"
											 Foreground="Gray" />
					</DockPanel>
					<DockPanel Margin="2">
						<Rectangle Style="{StaticResource SwatchRect}"
											 Fill="{Binding Model.PrimaryAlt, Converter={StaticResource ColorToBrush}}" />
						<TextBlock Text="PrimaryAlt"
											 Width="140"
											 VerticalAlignment="Center" />
						<TextBlock Text="{Binding Model.PrimaryAlt, Converter={StaticResource ColorToBrush}, StringFormat={}{0}}"
											 VerticalAlignment="Center"
											 Foreground="Gray" />
					</DockPanel>
					<DockPanel Margin="2">
						<Rectangle Style="{StaticResource SwatchRect}"
											 Fill="{Binding Model.PrimaryAlt2, Converter={StaticResource ColorToBrush}}" />
						<TextBlock Text="PrimaryAlt2"
											 Width="140"
											 VerticalAlignment="Center" />
						<TextBlock Text="{Binding Model.PrimaryAlt2, Converter={StaticResource ColorToBrush}, StringFormat={}{0}}"
											 VerticalAlignment="Center"
											 Foreground="Gray" />
					</DockPanel>
					<DockPanel Margin="2">
						<Rectangle Style="{StaticResource SwatchRect}"
											 Fill="{Binding Model.PrimaryAlt3, Converter={StaticResource ColorToBrush}}" />
						<TextBlock Text="PrimaryAlt3"
											 Width="140"
											 VerticalAlignment="Center" />
						<TextBlock Text="{Binding Model.PrimaryAlt3, Converter={StaticResource ColorToBrush}, StringFormat={}{0}}"
											 VerticalAlignment="Center"
											 Foreground="Gray" />
					</DockPanel>
					<DockPanel Margin="2">
						<Rectangle Style="{StaticResource SwatchRect}"
											 Fill="{Binding Model.PrimaryAlt4, Converter={StaticResource ColorToBrush}}" />
						<TextBlock Text="PrimaryAlt4"
											 Width="140"
											 VerticalAlignment="Center" />
						<TextBlock Text="{Binding Model.PrimaryAlt4, Converter={StaticResource ColorToBrush}, StringFormat={}{0}}"
											 VerticalAlignment="Center"
											 Foreground="Gray" />
					</DockPanel>
					<DockPanel Margin="2">
						<Rectangle Style="{StaticResource SwatchRect}"
											 Fill="{Binding Model.PrimaryContrast, Converter={StaticResource ColorToBrush}}" />
						<TextBlock Text="PrimaryContrast"
											 Width="140"
											 VerticalAlignment="Center" />
						<TextBlock Text="{Binding Model.PrimaryContrast, Converter={StaticResource ColorToBrush}, StringFormat={}{0}}"
											 VerticalAlignment="Center"
											 Foreground="Gray" />
					</DockPanel>
				</StackPanel>
			</Expander>

