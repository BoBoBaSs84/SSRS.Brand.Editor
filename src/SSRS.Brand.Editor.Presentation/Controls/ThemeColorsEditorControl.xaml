<UserControl x:Class="SSRS.Brand.Editor.Presentation.Controls.ThemeColorsEditorControl"
						 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:vm="clr-namespace:SSRS.Brand.Editor.Application.ViewModels;assembly=SSRS.Brand.Editor.Application"
						 xmlns:conv="clr-namespace:SSRS.Brand.Editor.Presentation.Converters"
						 xmlns:local="clr-namespace:SSRS.Brand.Editor.Presentation.Controls"
						 mc:Ignorable="d"
						 d:DataContext="{d:DesignInstance Type=vm:ThemeColorsViewModel}"
						 d:Background="WhiteSmoke"
						 d:Width="380">
	<UserControl.Resources>
		<conv:DrawingColorToBrushConverter x:Key="ColorToBrush" />
		<Style x:Key="SwatchRect"
					 TargetType="Rectangle">
			<Setter Property="Width"
							Value="24" />
			<Setter Property="Height"
							Value="24" />
			<Setter Property="Stroke"
							Value="Gray" />
			<Setter Property="StrokeThickness"
							Value="1" />
			<Setter Property="RadiusX"
							Value="2" />
			<Setter Property="RadiusY"
							Value="2" />
			<Setter Property="Margin"
							Value="0,0,8,0" />
		</Style>
	</UserControl.Resources>
	<ScrollViewer VerticalScrollBarVisibility="Auto"
								Padding="8">
		<StackPanel Margin="8">
			<TextBlock Text="Theme Colors"
								 FontSize="16"
								 FontWeight="SemiBold"
								 Margin="0,0,0,12" />

			<!-- Data Points -->
			<Expander Header="Data Points"
								IsExpanded="True"
								Margin="0,0,0,4">
				<StackPanel Margin="4">
					<DockPanel Margin="0,0,0,8">
						<Button Content="+ Add"
										Command="{Binding AddDataPointCommand}"
										Padding="8,2"
										DockPanel.Dock="Left"
										Margin="0,0,4,0" />
						<Button Content="- Remove"
										Command="{Binding RemoveDataPointCommand}"
										Padding="8,2"
										DockPanel.Dock="Left"
										Margin="0,0,8,0" />
						<TextBlock VerticalAlignment="Center"
											 Foreground="Gray">
							<Run Text="{Binding DataPoints.Count, Mode=OneWay}" />
							<Run Text=" data point(s)" />
						</TextBlock>
					</DockPanel>
					<ItemsControl ItemsSource="{Binding DataPoints}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<DockPanel Margin="2">
									<Rectangle Style="{StaticResource SwatchRect}"
														 Fill="{Binding Converter={StaticResource ColorToBrush}}" />
									<TextBlock VerticalAlignment="Center"
														 Foreground="Gray"
														 Text="{Binding Converter={StaticResource ColorToBrush}, StringFormat={}{0}}" />
								</DockPanel>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
			</Expander>

			<!-- Status -->
			<Expander Header="Status"
								Margin="0,0,0,4">
				<StackPanel Margin="4">
					<local:ColorSwatchControl Label="Good"
																		Color="{Binding Model.Good}" />
					<local:ColorSwatchControl Label="Bad"
																		Color="{Binding Model.Bad}" />
					<local:ColorSwatchControl Label="Neutral"
																		Color="{Binding Model.Neutral}" />
					<local:ColorSwatchControl Label="None"
																		Color="{Binding Model.None}" />
				</StackPanel>
			</Expander>

			<!-- Standard -->
			<Expander Header="Standard"
								Margin="0,0,0,4">
				<StackPanel Margin="4">
					<local:ColorSwatchControl Label="Background"
																		Color="{Binding Model.Background}" />
					<local:ColorSwatchControl Label="Foreground"
																		Color="{Binding Model.Foreground}" />
					<local:ColorSwatchControl Label="MapBase"
																		Color="{Binding Model.MapBase}" />
					<local:ColorSwatchControl Label="PanelBackground"
																		Color="{Binding Model.PanelBackground}" />
					<local:ColorSwatchControl Label="PanelForeground"
																		Color="{Binding Model.PanelForeground}" />
					<local:ColorSwatchControl Label="PanelAccent"
																		Color="{Binding Model.PanelAccent}" />
					<local:ColorSwatchControl Label="TableAccent"
																		Color="{Binding Model.TableAccent}" />
				</StackPanel>
			</Expander>

			<!-- Alt -->
			<Expander Header="Alt"
								Margin="0,0,0,4">
				<StackPanel Margin="4">
					<local:ColorSwatchControl Label="AltBackground"
																		Color="{Binding Model.AltBackground}" />
					<local:ColorSwatchControl Label="AltForeground"
																		Color="{Binding Model.AltForeground}" />
					<local:ColorSwatchControl Label="AltMapBase"
																		Color="{Binding Model.AltMapBase}" />
					<local:ColorSwatchControl Label="AltPanelBackground"
																		Color="{Binding Model.AltPanelBackground}" />
					<local:ColorSwatchControl Label="AltPanelForeground"
																		Color="{Binding Model.AltPanelForeground}" />
					<local:ColorSwatchControl Label="AltPanelAccent"
																		Color="{Binding Model.AltPanelAccent}" />
					<local:ColorSwatchControl Label="AltTableAccent"
																		Color="{Binding Model.AltTableAccent}" />
				</StackPanel>
			</Expander>
		</StackPanel>
	</ScrollViewer>
</UserControl>
