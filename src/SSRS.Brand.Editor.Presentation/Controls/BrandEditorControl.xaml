<UserControl x:Class="SSRS.Brand.Editor.Presentation.Controls.BrandEditorControl"
						 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:vm="clr-namespace:SSRS.Brand.Editor.Application.ViewModels;assembly=SSRS.Brand.Editor.Application"
						 xmlns:conv="clr-namespace:SSRS.Brand.Editor.Presentation.Converters"
						 xmlns:controls="clr-namespace:SSRS.Brand.Editor.Presentation.Controls"
						 mc:Ignorable="d"
						 d:DataContext="{d:DesignInstance Type=vm:BrandEditorViewModel}"
						 d:Background="WhiteSmoke"
						 d:Height="600"
						 d:Width="1200">
	<UserControl.Resources>
		<conv:BoolToVisibilityConverter x:Key="BoolToVis" />
		<conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
	</UserControl.Resources>
	<Grid>
		<!-- Welcome screen when no package loaded -->
		<StackPanel HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Visibility="{Binding HasPackage, Converter={StaticResource InverseBoolToVis}}">
			<TextBlock Text="SSRS Brand Editor"
								 FontSize="28"
								 FontWeight="Light"
								 HorizontalAlignment="Center"
								 Margin="0,0,0,10" />
			<TextBlock Text="Create or open a brand package to get started."
								 FontSize="14"
								 Foreground="Gray"
								 HorizontalAlignment="Center"
								 Margin="0,0,0,20" />
			<StackPanel Orientation="Horizontal"
									HorizontalAlignment="Center">
				<Button Content="  New  "
								Command="{Binding NewCommand}"
								Padding="12,6"
								Margin="5" />
				<Button Content="  Open...  "
								Command="{Binding OpenCommand}"
								Padding="12,6"
								Margin="5" />
			</StackPanel>
		</StackPanel>

		<!-- Editor + Preview when package is loaded -->
		<Grid Visibility="{Binding HasPackage, Converter={StaticResource BoolToVis}}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="400"
													MinWidth="300" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*"
													MinWidth="400" />
			</Grid.ColumnDefinitions>

			<!-- Editor Panel -->
			<TabControl Grid.Column="0"
									Margin="4">
				<TabItem Header="Metadata">
					<controls:MetadataEditorControl DataContext="{Binding MetadataViewModel}" />
				</TabItem>
				<TabItem Header="Interface">
					<controls:InterfaceColorsEditorControl DataContext="{Binding InterfaceColorsViewModel}" />
				</TabItem>
				<TabItem Header="Theme">
					<controls:ThemeColorsEditorControl DataContext="{Binding ThemeColorsViewModel}" />
				</TabItem>
				<TabItem Header="Logo">
					<controls:LogoEditorControl DataContext="{Binding LogoViewModel}" />
				</TabItem>
			</TabControl>

			<GridSplitter Grid.Column="1"
										Width="4"
										HorizontalAlignment="Center"
										VerticalAlignment="Stretch"
										Background="LightGray" />

			<!-- Live Preview Panel -->
			<controls:PortalPreviewControl Grid.Column="2"
																		 DataContext="{Binding}"
																		 Margin="4" />
		</Grid>
	</Grid>
</UserControl>
