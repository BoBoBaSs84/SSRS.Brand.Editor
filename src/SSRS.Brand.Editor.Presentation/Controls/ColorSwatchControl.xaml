<UserControl x:Class="SSRS.Brand.Editor.Presentation.Controls.ColorSwatchControl"
						 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:local="clr-namespace:SSRS.Brand.Editor.Presentation.Controls"
						 xmlns:conv="clr-namespace:SSRS.Brand.Editor.Presentation.Converters"
						 mc:Ignorable="d"
						 x:Name="Root">
	<UserControl.Resources>
		<conv:DrawingColorToBrushConverter x:Key="ColorToBrush" />
	</UserControl.Resources>
	<DockPanel Margin="2">
		<ToggleButton x:Name="SwatchToggle"
									Width="24"
									Height="24"
									Margin="0,0,8,0"
									Cursor="Hand"
									IsChecked="{Binding IsOpen, ElementName=ColorPickerPopup, Mode=TwoWay}">
			<ToggleButton.Template>
				<ControlTemplate TargetType="ToggleButton">
					<Rectangle Width="24"
										 Height="24"
										 Stroke="Gray"
										 StrokeThickness="1"
										 RadiusX="2"
										 RadiusY="2"
										 Fill="{Binding Color, ElementName=Root, Converter={StaticResource ColorToBrush}}" />
				</ControlTemplate>
			</ToggleButton.Template>
		</ToggleButton>
		<TextBlock Text="{Binding Label, ElementName=Root}"
							 Width="140"
							 VerticalAlignment="Center" />
		<TextBlock VerticalAlignment="Center"
							 Foreground="Gray"
							 Text="{Binding Color, ElementName=Root, Converter={StaticResource ColorToBrush}, StringFormat={}{0}}" />
		<Popup x:Name="ColorPickerPopup"
					 StaysOpen="False"
					 AllowsTransparency="True"
					 Placement="Right"
					 PlacementTarget="{Binding ElementName=SwatchToggle}"
					 PopupAnimation="Fade">
			<Border Background="WhiteSmoke"
							BorderBrush="Gray"
							BorderThickness="1"
							CornerRadius="4"
							Padding="4">
				<local:ColorPickerControl x:Name="Picker"
																	SelectedColor="{Binding Color, ElementName=Root, Mode=TwoWay}"
																	ColorApplied="Picker_ColorApplied" />
			</Border>
		</Popup>
	</DockPanel>
</UserControl>
