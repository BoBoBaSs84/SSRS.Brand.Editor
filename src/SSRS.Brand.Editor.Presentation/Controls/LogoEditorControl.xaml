<UserControl x:Class="SSRS.Brand.Editor.Presentation.Controls.LogoEditorControl"
						 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:vm="clr-namespace:SSRS.Brand.Editor.Application.ViewModels;assembly=SSRS.Brand.Editor.Application"
						 xmlns:conv="clr-namespace:SSRS.Brand.Editor.Presentation.Converters"
						 mc:Ignorable="d"
						 d:DataContext="{d:DesignInstance Type=vm:LogoViewModel}"
						 d:Background="WhiteSmoke"
						 d:Width="380">
	<UserControl.Resources>
		<conv:BoolToVisibilityConverter x:Key="BoolToVis" />
		<conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
		<conv:ByteArrayToImageSourceConverter x:Key="BytesToImage" />
	</UserControl.Resources>
	<StackPanel Margin="16">
		<TextBlock Text="Logo"
							 FontSize="16"
							 FontWeight="SemiBold"
							 Margin="0,0,0,12" />

		<TextBlock Text="The logo replaces the portal name in the title bar."
							 Foreground="Gray"
							 TextWrapping="Wrap"
							 Margin="0,0,0,8" />

		<TextBlock Text="Recommended size: 290 x 60 pixels (PNG format)."
							 Foreground="Gray"
							 FontSize="11"
							 Margin="0,0,0,16" />

		<!-- Logo Preview -->
		<Border BorderBrush="LightGray"
						BorderThickness="1"
						Background="#F5F5F5"
						Padding="8"
						MinHeight="80"
						Margin="0,0,0,16"
						HorizontalAlignment="Left"
						MaxWidth="320">
			<Grid>
				<TextBlock Text="(No logo selected)"
									 Foreground="Gray"
									 HorizontalAlignment="Center"
									 VerticalAlignment="Center"
									 Visibility="{Binding HasLogo, Converter={StaticResource InverseBoolToVis}}" />
				<Image Source="{Binding LogoBytes, Converter={StaticResource BytesToImage}}"
							 MaxWidth="290"
							 MaxHeight="60"
							 Stretch="Uniform"
							 HorizontalAlignment="Left"
							 Visibility="{Binding HasLogo, Converter={StaticResource BoolToVis}}" />
			</Grid>
		</Border>

		<!-- Buttons -->
		<StackPanel Orientation="Horizontal">
			<Button Content="  Browse...  "
							Command="{Binding BrowseCommand}"
							Padding="8,4"
							Margin="0,0,8,0" />
			<Button Content="  Remove  "
							Command="{Binding RemoveCommand}"
							Padding="8,4" />
		</StackPanel>
	</StackPanel>
</UserControl>
